# Copy this file to .env.local and paste in your own values.
# Supabase dashboard -> Connect -> Framework -> Next.js
# (or Project Settings -> Data API for the URL, API Keys for the key)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The browser-safe key. Newer projects call this the "publishable" key
# (sb_publishable_...); older ones call it the "anon" key (a long eyJ... JWT).
# Either variable name works — set whichever one your dashboard gives you.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the service_role / sb_secret_ key in a NEXT_PUBLIC_ variable.
# It bypasses every row-level security policy and ships to the browser.
